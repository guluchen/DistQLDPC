+  destruct (_ && _ && _)%bool eqn:C; [|reflexivity].
+  repeat rewrite andb_true_iff in C; destruct C as [[I J] Odd].
+  apply Nat.ltb_lt in I,J.
+  set (h:=nth i hs zero_vector);set (g:=nth j hs zero_vector).
+  assert (Neutral:parity n (vxor h g) e=false).
+  { rewrite pair_dot; unfold h,g; rewrite !K by (apply nth_In;assumption);reflexivity. }
+  assert (Bad:parity n (vxor h g) s=true).
+  { rewrite pair_dot; unfold h,g; now rewrite <- (Sig i), <- (Sig j). }
+  destruct(odd_row_has_target_extension n (vxor h g) s e (proj1 Fit) Bad Neutral)
+    as [q [Q [HQ [E S0]]]].
+  set (reserved:=meet a (add_bits (support_mask (row i)) (support_mask (row j)))).
+  assert (Hit:decode reserved q=true).
+  { unfold reserved;rewrite decode_meet,decode_add,(proj2 Fit q Q E S0).
+    destruct (L i I) as [A _],(L j J) as [G _].
+    rewrite (A q Q),(G q Q); exact HQ. }
+  assert (Drop:weight n (unseen e s reserved)<weight n (vdiff e s)).
+  { eapply (weight_strict_extra n _ _ q).
+    - intros u U V; apply andb_true_iff in V as [D _]; exact D.
+    - exact Q.
+    - unfold unseen; rewrite Hit,andb_false_r;reflexivity.
+    - unfold vdiff; rewrite E,S0;reflexivity. }
+  destruct rem as [|k];[lia|].
+  eapply (packing_safe n hs ls test row e s sy a reserved ids k);try assumption;lia.
+Qed.
