+(* A sum of two check rows is another check row. If it is odd on the prefix,
+   it needs a free correcting qubit just like a physical row. Its support
+   can therefore be reserved before testing the other disjoint odd rows. *)
+Definition pair_cut m test row sy free rem ids i j :=
+  if (i <? m) && (j <? m) && xorb (decode sy i) (decode sy j) then
+    let reserved:=meet free (add_bits (support_mask (row i)) (support_mask (row j))) in
+    match rem with
+    | 0 => true
+    | S k => packing_cut test row sy free k reserved ids
+    end
+  else false.
+
+Lemma pair_dot n h g x :
+  parity n (vxor h g) x=xorb (parity n h x) (parity n g x).
+Proof.
+  rewrite qcert_parity_comm,parity_xor,(qcert_parity_comm n x h),(qcert_parity_comm n x g).
+  reflexivity.
+Qed.
