+Definition valid_odd_sum m sy ids :=
+  forallb (fun i=>i<?m) ids && sum_syndrome sy ids.
+Definition double_cut m test row sy free rem packed first second :=
+  if valid_odd_sum m sy first && valid_odd_sum m sy second then
+    let a:=meet free (sum_support row first) in
+    let b:=meet free (sum_support row second) in
+    if disjoint a b then
+      match rem with
+      | S (S k)=>packing_cut test row sy free k (join a b) packed
+      | _=>true end
+    else false
+  else false.
