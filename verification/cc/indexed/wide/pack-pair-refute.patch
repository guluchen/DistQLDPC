+Qed.
+Definition linear_cut m test row sy free rem packed ids :=
+ if forallb (fun i=>i<?m) ids && sum_syndrome sy ids then
+   match rem with 0=>true |S k=>
+    packing_cut test row sy free k (meet free (sum_support row ids)) packed end
+ else false.
+Lemma linear_cut_safe n hs ls test row e s sy free packed ids rem :
+ active_ok (length hs) test -> layout n hs ls row -> kernel n hs e ->
+ signature n hs s sy -> fits n e s free -> weight n (vdiff e s)<=rem ->
+ linear_cut (length hs) test row sy free rem packed ids=false.
+Proof.
+ intros Act L K Sig Fit Bound;unfold linear_cut.
+ destruct (_ && _)%bool eqn:C;[|reflexivity].
+ apply andb_true_iff in C as [C Odd].
+ assert (Indices:Forall (fun i=>i<length hs) ids).
+ { apply Forall_forall;rewrite forallb_forall in C;intros i I;apply Nat.ltb_lt;auto. }
+ rewrite <-(sum_on_prefix _ _ _ _ _ Sig Indices) in Odd.
+ destruct(odd_row_has_target_extension n _ s e (proj1 Fit) Odd (sum_on_kernel _ _ _ _ K Indices))
+   as [q [Q [On [E S0]]]].
+ set(region:=meet free (sum_support row ids)).
+ assert(Hit:decode region q=true).
+ { unfold region;rewrite decode_meet,(proj2 Fit q Q E S0);cbn.
+   rewrite (support_sum_agrees _ _ _ _ _ L Indices q Q);exact On. }
+ assert(Drop:weight n (unseen e s region)<weight n (vdiff e s)).
+ { eapply (weight_strict_extra n _ _ q).
+   - intros j J V;apply andb_true_iff in V as [V _];exact V.
+   - exact Q.
+   - unfold unseen;rewrite Hit,andb_false_r;reflexivity.
+   - unfold vdiff;rewrite E,S0;reflexivity. }
+ destruct rem as [|k];[lia|].
+ eapply (packing_safe n hs ls test row e s sy free region packed k);try assumption;lia.
+Qed.
