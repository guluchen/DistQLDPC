# Explicit bit-flip/readout model. Perfect preparation and final data readout.
# The only stochastic locations are the X_ERROR and M(p) instructions.
R 0 1 2 3 4
CX 0 3 1 3
M 3
CX 1 4 2 4
M 4
DETECTOR rec[-2]
DETECTOR rec[-1]

X_ERROR(0.001) 0 1 2
R 3 4
CX 0 3 1 3
M(0.001) 3
DETECTOR rec[-1] rec[-3]
CX 1 4 2 4
M(0.001) 4
DETECTOR rec[-1] rec[-3]

M 0 1 2
DETECTOR rec[-5] rec[-3] rec[-2]
DETECTOR rec[-4] rec[-2] rec[-1]
OBSERVABLE_INCLUDE(0) rec[-3]
