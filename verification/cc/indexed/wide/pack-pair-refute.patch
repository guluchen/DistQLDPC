+Fixpoint sum_support (row:nat->packed_row) ids :=
+ match ids with []=>none |i::t=>add_bits (support_mask(row i)) (sum_support row t) end.
+Fixpoint sum_row (hs:list vector) ids :=
+ match ids with []=>zero_vector |i::t=>vxor (nth i hs zero_vector) (sum_row hs t) end.
+Fixpoint sum_syndrome sy ids :=
+ match ids with []=>false |i::t=>xorb (decode sy i) (sum_syndrome sy t) end.
+Lemma support_sum_agrees n hs ls row ids :
+ layout n hs ls row -> Forall (fun i=>i<length hs) ids ->
+ forall q,q<n->decode(sum_support row ids)q=sum_row hs ids q.
+Proof.
+ intros L F;induction F as [|i ids I T IH];intros q Q;cbn.
+ - apply decode_none.
+ - unfold vxor;rewrite decode_add,(proj1(L i I) q Q),IH by exact Q;reflexivity.
+Qed.
+Lemma sum_on_prefix n hs s sy ids : signature n hs s sy ->
+ Forall (fun i=>i<length hs) ids -> parity n (sum_row hs ids) s=sum_syndrome sy ids.
+Proof.
+ intros S F;induction F as [|i ids I T IH];cbn.
+ - apply qcert_zero_dot.
+ - rewrite pair_dot,IH,<- (S i);reflexivity.
+Qed.
+Lemma sum_on_kernel n hs e ids : kernel n hs e ->
+ Forall (fun i=>i<length hs) ids -> parity n (sum_row hs ids) e=false.
+Proof.
+ intros K F;induction F as [|i ids I T IH];cbn.
+ - apply qcert_zero_dot.
