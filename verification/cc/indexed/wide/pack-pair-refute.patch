+Lemma odd_sum_hit n hs ls row e s sy free ids :
+  layout n hs ls row -> kernel n hs e -> signature n hs s sy -> fits n e s free ->
+  valid_odd_sum (length hs) sy ids=true ->
+  exists q,q<n /\ vdiff e s q=true /\ decode (meet free (sum_support row ids)) q=true.
+Proof.
+  intros L K Sig Fit Valid;apply andb_true_iff in Valid as [Valid Odd].
+  assert (Indices:Forall (fun i=>i<length hs) ids).
+  { apply Forall_forall;rewrite forallb_forall in Valid;intros i I;apply Nat.ltb_lt;auto. }
+  rewrite <-(sum_on_prefix _ _ _ _ _ Sig Indices) in Odd.
+  destruct (odd_row_has_target_extension n _ s e (proj1 Fit) Odd
+    (sum_on_kernel _ _ _ _ K Indices)) as [q [Q [On [E S0]]]].
+  exists q;split;[exact Q|]. split.
+  - unfold vdiff;rewrite E,S0;reflexivity.
+  - rewrite decode_meet,(proj2 Fit q Q E S0).
+    now rewrite (support_sum_agrees _ _ _ _ _ L Indices q Q).
+Qed.
