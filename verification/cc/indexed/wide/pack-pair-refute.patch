+Lemma double_cut_safe n hs ls test row e s sy free packed first second rem :
+  active_ok (length hs) test -> layout n hs ls row -> kernel n hs e ->
+  signature n hs s sy -> fits n e s free -> weight n (vdiff e s)<=rem ->
+  double_cut (length hs) test row sy free rem packed first second=false.
+Proof.
+  intros Act L K Sig Fit Bound;unfold double_cut.
+  destruct (_ && _)%bool eqn:Valid;[|reflexivity].
+  apply andb_true_iff in Valid as [First Second].
+  set (a:=meet free (sum_support row first)).
+  set (b:=meet free (sum_support row second)).
+  destruct (disjoint a b) eqn:D;[|reflexivity].
+  destruct (odd_sum_hit _ _ _ _ _ _ _ _ _ L K Sig Fit First) as [p [P [DeltaP HitP]]].
+  destruct (odd_sum_hit _ _ _ _ _ _ _ _ _ L K Sig Fit Second) as [q [Q [DeltaQ HitQ]]].
+  fold a in HitP;fold b in HitQ.
+  assert (Outside:decode a q=false).
+  { rewrite disjoint_meet in D;apply empty_none in D.
+    pose proof (f_equal (fun bits=>decode bits q) D) as H;cbn beta in H.
+    rewrite decode_meet,decode_none,HitQ,andb_true_r in H;exact H. }
+  assert (Drop:weight n (unseen e s a)<weight n (vdiff e s)).
+  { eapply (weight_strict_extra n _ _ p).
+    - intros j J V;apply andb_true_iff in V as [V _];exact V.
+    - exact P.
+    - unfold unseen;rewrite HitP,andb_false_r;reflexivity.
+    - exact DeltaP. }
+  pose proof (unseen_join n e s a b q Q DeltaQ Outside HitQ).
+  destruct rem as [|[|k]];try lia.
+  apply (packing_safe n hs ls test row e s sy free (join a b) packed k);try assumption;lia.
+Qed.
